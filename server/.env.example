# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Note: If this fails or is omitted, QuickKart falls back to an in-memory database automatically!
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickkart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=quickkart_super_secure_jwt_token_secret_key_2026

# Client Application URL
APP_BASE_URL=http://localhost:5173

# Juspay ExpressCheckout Gateway Credentials (Sandbox)
JUSPAY_MERCHANT_ID=sandbox_quickkart
JUSPAY_API_KEY=sandbox_api_key_demo
JUSPAY_BASE_URL=https://sandbox.juspay.in
JUSPAY_CLIENT_ID=quickkart_client
